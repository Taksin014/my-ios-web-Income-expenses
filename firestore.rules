rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════
    //  users/{uid}/transactions/{txId}
    //  — แต่ละคนเข้าถึงได้แค่ข้อมูลของตัวเอง
    // ══════════════════════════════════════════════════
    match /users/{uid}/transactions/{txId} {

      // อ่านได้เฉพาะเจ้าของ
      allow read: if request.auth != null
                  && request.auth.uid == uid;

      // เขียน/แก้ไขได้เฉพาะเจ้าของ
      // และ validate โครงสร้างข้อมูลด้วย
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && isValidTransaction(request.resource.data);

      // ลบได้เฉพาะเจ้าของ
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    // ปิดกั้น path อื่นทั้งหมด
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Validation function ──────────────────────────
function isValidTransaction(data) {
  return data.keys().hasAll(['id', 'type', 'amount', 'date'])
    && data.id is string
    && data.id.size() > 0
    && data.type in ['income', 'expense']
    && data.amount is number
    && data.amount > 0
    && data.date is string
    && data.date.matches('\\d{4}-\\d{2}-\\d{2}');
}
