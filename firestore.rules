rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             request.auth.token.email == 'facebookthaitaksin1@gmail.com';
    }

    // เช็คว่า user ถูกแบนหรือเปล่า โดยดูจาก banned_users collection
    function isBanned() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/banned_users/$(request.auth.uid));
    }

    // ─── Users collection ──────────────────────────────────────
    // เก็บ profile (displayName, email, photoURL, lastSeen)
    match /users/{userId} {
      allow read:
        if isAdmin() || (isSignedIn() && request.auth.uid == userId && !isBanned());
      allow write:
        if isAdmin() || (isSignedIn() && request.auth.uid == userId && !isBanned());

      // ─── Transactions subcollection ───────────────────────
      // Admin อ่าน/เขียน/ลบของทุก user ได้
      // User อ่าน/เขียน/ลบเฉพาะของตัวเอง (ถ้าไม่โดนแบน)
      match /transactions/{txId} {
        allow read, write, delete:
          if isAdmin() ||
             (isSignedIn() && request.auth.uid == userId && !isBanned());
      }
    }

    // ─── Banned users collection ───────────────────────────────
    // เก็บ { uid, bannedAt, bannedBy } ของ user ที่ถูกแบน
    // Admin เขียน/ลบ/อ่านได้อย่างเดียว — user อื่นแตะไม่ได้เลย
    match /banned_users/{uid} {
      allow read, write, delete: if isAdmin();
    }

  }
}
